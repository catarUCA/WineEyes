# --- Database (catalogue) ---
# For local (non-Docker) runs use MYSQL_HOST=localhost.
# Under docker compose the backend reaches the DB by service name (mariadb);
# the compose file sets MYSQL_HOST=mariadb automatically.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=wineeyes
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=oderismo
# Required by the mariadb container (root account); use a strong value.
MYSQL_ROOT_PASSWORD=change_me_too

# --- Application ---
SECRET_KEY=replace_with_a_long_random_value
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3300,http://localhost:5173

# --- Optional: host paths for processed images/thumbnails/debug ---
# Defaults to ./runtime/* when unset (see docker-compose.yml).
# IMAGE_DEST_HOST=./runtime/processed
# THUMB_DEST_HOST=./runtime/thumbnails
# DEBUG_DIR_HOST=./runtime/debug
